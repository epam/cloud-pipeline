<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    <bean class="com.epam.pipeline.dao.security.NamedJwtTokenDao" id="namedJwtTokenDao" autowire="byName">
        <property name="insertTokenQuery">
            <value>
                <![CDATA[
                    INSERT INTO pipeline.jwt_named_token (
                        jti,
                        user_id,
                        created_by,
                        token_name,
                        issued_at,
                        expires_at)
                    VALUES (
                        :JTI,
                        :USER_ID,
                        :CREATED_BY,
                        :TOKEN_NAME,
                        :ISSUED_AT,
                        :EXPIRES_AT)
                ]]>
            </value>
        </property>
        <property name="loadByJtiQuery">
            <value>
                <![CDATA[
                    SELECT
                        jti,
                        user_id,
                        created_by,
                        token_name,
                        issued_at,
                        expires_at
                    FROM pipeline.jwt_named_token
                    WHERE jti = ?
                ]]>
            </value>
        </property>
        <property name="loadByUserIdQuery">
            <value>
                <![CDATA[
                    SELECT
                        jti,
                        user_id,
                        created_by,
                        token_name,
                        issued_at,
                        expires_at
                    FROM pipeline.jwt_named_token
                    WHERE user_id = ?
                    ORDER BY issued_at DESC
                ]]>
            </value>
        </property>
        <property name="countByUserIdQuery">
            <value>
                <![CDATA[
                    SELECT COUNT(*)
                    FROM pipeline.jwt_named_token
                    WHERE user_id = ?
                ]]>
            </value>
        </property>
        <property name="deleteByJtiQuery">
            <value>
                <![CDATA[
                    DELETE FROM pipeline.jwt_named_token WHERE jti = ?
                ]]>
            </value>
        </property>
        <property name="deleteByUserIdQuery">
            <value>
                <![CDATA[
                    DELETE FROM pipeline.jwt_named_token WHERE user_id = ?
                ]]>
            </value>
        </property>
    </bean>
</beans>
