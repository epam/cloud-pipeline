  "settings": {
    "jest.autoRun": "off",
    "chat.tools.terminal.autoApprove": {
      "Set-Location": true,
      "&": true,
      "Get-Item": true,
    },
    // "editor.formatOnSave": true,
    "[typescript]": {
      "editor.defaultFormatter": "vscode.typescript-language-features",
    },
    "[typescriptreact]": {
