# Docker versions download
# mkdir docker
# cd docker
# wget -A tgz -m -p -E -k -K -np https://download.docker.com/linux/static/stable/x86_64/
# cd download.docker.com
# aws s3 sync linux/static/stable/x86_64 s3://cloud-pipeline-oss-builds/tools/docker/distr/linux/static/stable/x86_64

DIND_SETUP_TASK="SetupDinD"

pipe_log_info "Started DIND setup" "$DIND_SETUP_TASK"

# In the rootless mode dockerd runs as the run owner, see dind_setup_rootless
source "$COMMON_REPO_DIR/shell/dind_setup_rootless"
if check_cp_cap "CP_CAP_DIND_CONTAINER_ROOTLESS"; then
    _DIND_ROOTLESS="true"
fi

if [ "$CP_OS" == "rocky" ] || [ "$CP_OS" == "rhel" ]; then
    _CP_CAP_DIND_VERSION_DEFAULT="20.10.24"
else
    _CP_CAP_DIND_VERSION_DEFAULT="18.09.6"
fi
if [ "$_DIND_ROOTLESS" == "true" ]; then
    _CP_CAP_DIND_VERSION_DEFAULT="$DIND_ROOTLESS_DEFAULT_VERSION"
fi
export CP_CAP_DIND_VERSION="${CP_CAP_DIND_VERSION:-$_CP_CAP_DIND_VERSION_DEFAULT}"
export CP_CAP_DIND_CHANNEL="${CP_CAP_DIND_CHANNEL:-stable}"
export CP_CAP_DIND_ARCH="${CP_CAP_DIND_ARCH:-x86_64}"
export CP_CAP_DIND_DISTR_PREFIX="${CP_CAP_DIND_DISTR_PREFIX:-"${GLOBAL_DISTRIBUTION_URL}tools/docker/distr"}"

######################################################
# Check the rootless mode requirements
######################################################
if [ "$_DIND_ROOTLESS" == "true" ]; then
    pipe_log_info "Rootless mode is requested: dockerd will run as $OWNER" "$DIND_SETUP_TASK"
    if ! dind_rootless_check_user "$OWNER"; then
        pipe_log_fail "Rootless mode needs a non-root run owner, but the owner is '$OWNER', aborting" "$DIND_SETUP_TASK"
        exit 1
    fi
    if ! dind_rootless_check_version "$CP_CAP_DIND_VERSION"; then
        pipe_log_fail "Rootless mode needs docker $DIND_ROOTLESS_MIN_VERSION or newer, but $CP_CAP_DIND_VERSION is requested, aborting" "$DIND_SETUP_TASK"
        exit 1
    fi
    _DIND_ROOTLESS_SUBID_START="${CP_CAP_DIND_CONTAINER_ROOTLESS_SUBID_START:-$DIND_ROOTLESS_SUBID_START_DEFAULT}"
    if ! dind_rootless_check_subid_start "$_DIND_ROOTLESS_SUBID_START"; then
        pipe_log_fail "CP_CAP_DIND_CONTAINER_ROOTLESS_SUBID_START shall be a positive integer, but it is '$_DIND_ROOTLESS_SUBID_START', aborting" "$DIND_SETUP_TASK"
        exit 1
    fi
fi

pipe_log_info "Installing docker: ${CP_CAP_DIND_CHANNEL}/${CP_CAP_DIND_ARCH}/docker-${CP_CAP_DIND_VERSION}" "$DIND_SETUP_TASK"

######################################################
# Check if this is a RPM Linux distribution
######################################################
/usr/bin/rpm -q -f /usr/bin/rpm >/dev/null 2>&1
IS_RPM_BASED=$?

######################################################
# Install DIND dependencies
######################################################
_DIND_DEP_INSTALL_RESULT=0
if [ $IS_RPM_BASED -eq 0 ]; then
    if util_version_compare "$CP_CAP_DIND_VERSION" "20.10.24" "<"; then
        _extra_packages="btrfs-progs"
    fi
    if [ "$CP_OS" == "rhel" ]; then
       yum --nogpgcheck --repofrompath=centos,http://mirror.centos.org/centos/8-stream/BaseOS/x86_64/os/ install -y -q \
                e2fsprogs \
                xfsprogs
    else
       yum install -y -q \
                e2fsprogs \
                xfsprogs
    fi
    yum install -y -q \
                iptables \
                iproute \
                xz \
                pigz \
                kmod \
                findutils $_extra_packages
    _DIND_DEP_INSTALL_RESULT=$?
else
    apt install -y -qq \
                btrfs-progs \
                e2fsprogs \
                iptables \
                iproute2 \
                xfsprogs \
                xz-utils \
                pigz \
                kmod
    _DIND_DEP_INSTALL_RESULT=$?
fi

if [ $_DIND_DEP_INSTALL_RESULT -ne 0 ]; then
    pipe_log_fail "Unable to install DIND dependencies, aborting" "$DIND_SETUP_TASK"
    exit 1
fi

pipe_log_info "DIND dependencies installed" "$DIND_SETUP_TASK"

######################################################
# Install docker
######################################################

[ ! -e /etc/nsswitch.conf ] && echo 'hosts: files dns' > /etc/nsswitch.conf

wget -q -O docker.tgz "${CP_CAP_DIND_DISTR_PREFIX}/linux/static/${CP_CAP_DIND_CHANNEL}/${CP_CAP_DIND_ARCH}/docker-${CP_CAP_DIND_VERSION}.tgz"

if [ $? -ne 0 ]; then
    pipe_log_fail "Unable to download docker distribution ${CP_CAP_DIND_CHANNEL}/${CP_CAP_DIND_ARCH}/docker-${CP_CAP_DIND_VERSION}" "$DIND_SETUP_TASK"
    exit 1
fi

tar --extract --file docker.tgz --strip-components 1 --directory /usr/local/bin/
if [ $? -ne 0 ]; then
    pipe_log_fail "Unable to install docker distribution" "$DIND_SETUP_TASK"
    exit 1
fi
rm -f docker.tgz

pipe_log_info "Docker installed" "$DIND_SETUP_TASK"

######################################################
# Install the rootless mode components
######################################################
if [ "$_DIND_ROOTLESS" == "true" ]; then
    _DIND_ROOTLESS_EXTRAS_URL="${CP_CAP_DIND_DISTR_PREFIX}/linux/static/${CP_CAP_DIND_CHANNEL}/${CP_CAP_DIND_ARCH}/docker-rootless-extras-${CP_CAP_DIND_VERSION}.tgz"
    if ! dind_rootless_install_extras "$_DIND_ROOTLESS_EXTRAS_URL" /usr/local/bin/; then
        pipe_log_fail "Unable to install docker rootless extras from $_DIND_ROOTLESS_EXTRAS_URL, aborting" "$DIND_SETUP_TASK"
        exit 1
    fi
    if ! dind_rootless_install_idmap "$IS_RPM_BASED"; then
        pipe_log_fail "Unable to install newuidmap and newgidmap with the privileges to write the id maps, aborting" "$DIND_SETUP_TASK"
        exit 1
    fi
    if ! dind_rootless_set_subids "$OWNER" "$_DIND_ROOTLESS_SUBID_START" "$DIND_ROOTLESS_SUBID_COUNT" /etc/subuid || \
       ! dind_rootless_set_subids "$OWNER" "$_DIND_ROOTLESS_SUBID_START" "$DIND_ROOTLESS_SUBID_COUNT" /etc/subgid; then
        pipe_log_fail "Unable to add the subordinate ids of $OWNER to /etc/subuid and /etc/subgid, aborting" "$DIND_SETUP_TASK"
        exit 1
    fi
    if ! dind_rootless_ensure_tun; then
        pipe_log_fail "Unable to create /dev/net/tun, aborting" "$DIND_SETUP_TASK"
        exit 1
    fi
    pipe_log_info "Docker rootless extras installed, subordinate ids of $OWNER: $(grep "^$OWNER:" /etc/subuid)" "$DIND_SETUP_TASK"
fi

nvidia-smi &> /dev/null
REQUIRES_GPU_DIND=$?
if [ $REQUIRES_GPU_DIND -eq 0 ]; then
    pipe_log_info "Active CUDA environment detected, try to install NVIDIA Docker" "$DIND_SETUP_TASK"
    distribution=$(. /etc/os-release;echo $ID$VERSION_ID)
    if [ $IS_RPM_BASED -eq 0 ]; then
        export CP_CAP_DIND_GPU_VERSION="${CP_CAP_DIND_GPU_VERSION:-1.17.7-1}"
        if [ "$CP_CAP_DIND_GPU_VERSION_RPM" ]; then
            CP_CAP_DIND_GPU_VERSION="$CP_CAP_DIND_GPU_VERSION_RPM"
        fi

        curl -s -L "${GLOBAL_DISTRIBUTION_URL}tools/nvidia/libnvidia-container/rpm/stable/nvidia-container-toolkit.repo" > /etc/yum.repos.d/nvidia-container-toolkit.repo
        yum install -y nvidia-container-toolkit-$CP_CAP_DIND_GPU_VERSION
        _DIND_NVIDIA_DEP_INSTALL_RESULT=$?
        find /etc/yum.repos.d -type f \( -name "*nvidia*" -o -name "*docker*" \)  -exec rm -f {} \;
    else
        # Hacky way to make Ubuntu 24.04 DIND work with GPU
        if [ "$distribution" == "ubuntu24.04" ]; then
            distribution="ubuntu22.04"
        fi
        export CP_CAP_DIND_GPU_VERSION="${CP_CAP_DIND_GPU_VERSION:-3.13.0-1}"
        if [ "$CP_CAP_DIND_GPU_VERSION_DEB" ]; then
            CP_CAP_DIND_GPU_VERSION="$CP_CAP_DIND_GPU_VERSION_DEB"
        fi
        curl -s -L https://nvidia.github.io/nvidia-docker/gpgkey | apt-key add -
        curl -s -L https://nvidia.github.io/nvidia-docker/$distribution/nvidia-docker.list \
        | tee /etc/apt/sources.list.d/nvidia-docker.list
        apt-get update -yq && \
        apt-get install -yq nvidia-container-runtime=$CP_CAP_DIND_GPU_VERSION
        _DIND_NVIDIA_DEP_INSTALL_RESULT=$?
        rm /etc/apt/sources.list.d/nvidia-docker.list
    fi
    if [ $_DIND_NVIDIA_DEP_INSTALL_RESULT -ne 0 ]; then
        pipe_log_info "Unable to install NVIDIA DIND, 'nvidia' runtime will not be available" "$DIND_SETUP_TASK"
    fi
fi

######################################################
# Fix dockerd for DIND
######################################################

if util_version_compare "$CP_CAP_DIND_VERSION" "19.03.0" "<"; then
    export DIND_COMMIT=37498f009d8bf25fbb6199e8ccd34bed84f2874b
    wget -q -O /usr/local/bin/dind "https://raw.githubusercontent.com/docker/docker/${DIND_COMMIT}/hack/dind"

    if [ $? -ne 0 ]; then
        pipe_log_fail "Unable to install download dind fix $DIND_COMMIT" "$DIND_SETUP_TASK"
        exit 1
    fi
    chmod +x /usr/local/bin/dind
    pipe_log_info "DIND fix installed: $DIND_COMMIT" "$DIND_SETUP_TASK"
fi

\cp $COMMON_REPO_DIR/shell/dind_setup_modprobe /usr/local/bin/modprobe
chmod +x /usr/local/bin/modprobe

######################################################
# Setup docker daemon options
######################################################
DIND_DATA_ROOT="${DIND_DATA_ROOT:-"$RUNS_ROOT/docker"}"
DIND_STORAGE_DRIVER="${DIND_STORAGE_DRIVER:-"btrfs"}"

if [ "$CP_CAP_DIND_REGISTRY_MIRRORS" ]; then
    IFS=',' read -r -a _DIND_REGISTRY_MIRRORS_ARR <<< "$CP_CAP_DIND_REGISTRY_MIRRORS"
    for _mirror in ${_DIND_REGISTRY_MIRRORS_ARR[@]}; do
        _DIND_REGISTRY_MIRRORS="\"$_mirror\","
    done
    _DIND_REGISTRY_MIRRORS=",\"registry-mirrors\": [${_DIND_REGISTRY_MIRRORS%,}]"
fi

if [ "$CP_CAP_DIND_DEBUG" == "true" ]; then
    _DIND_DEBUG=",\"debug\": $CP_CAP_DIND_DEBUG"
fi

if [ "$CP_CAP_DIND_EXTRA_ARGS" ]; then
    IFS=',' read -r -a _DIND_EXTRA_ARGS_ARR <<< "$CP_CAP_DIND_EXTRA_ARGS"
    for _extra_arg in ${_DIND_EXTRA_ARGS_ARR[@]}; do
        _extra_arg_name=$(echo "$_extra_arg" | cut -f1 -d'=')
        _extra_arg_val=$(echo "$_extra_arg" | cut -f2 -d'=')
        _DIND_EXTRA_ARGS="${_DIND_EXTRA_ARGS%,},\"$_extra_arg_name\": $_extra_arg_val"
    done
fi

pipe_log_info "DIND data root is set to: $DIND_DATA_ROOT" "$DIND_SETUP_TASK"
mkdir -p "$DIND_DATA_ROOT"
mkdir -p "/etc/docker"
cat <<EOT > /etc/docker/daemon.json
{
  "data-root": "$DIND_DATA_ROOT",
  "storage-driver": "$DIND_STORAGE_DRIVER"
  $_DIND_REGISTRY_MIRRORS
  $_DIND_DEBUG
  $_DIND_EXTRA_ARGS

}
EOT
if [ $REQUIRES_GPU_DIND -eq 0 ] && [ $_DIND_NVIDIA_DEP_INSTALL_RESULT -eq 0 ]; then
sed -i '1a \
  "runtimes": {\
      "nvidia": {\
          "path": "nvidia-container-runtime",\
          "runtimeArgs": []\
      }\
  },' /etc/docker/daemon.json
fi

######################################################
# Prepare the rootless mode daemon
######################################################
if [ "$_DIND_ROOTLESS" == "true" ]; then
    if [ $REQUIRES_GPU_DIND -eq 0 ] && [ $_DIND_NVIDIA_DEP_INSTALL_RESULT -eq 0 ]; then
        if ! dind_rootless_configure_nvidia; then
            pipe_log_warn "Unable to set no-cgroups = true for the NVIDIA runtime, containers with GPUs may fail to start" "$DIND_SETUP_TASK"
        fi
    fi
    _DIND_ROOTLESS_RUNTIME_DIR=$(dind_rootless_runtime_dir "$OWNER")
    _DIND_ROOTLESS_HOME="/var/lib/dind-rootless"
    _DIND_ROOTLESS_LOG="/var/log/dockerd-rootless.log"
    if ! dind_rootless_prepare_dirs "$OWNER" "$_DIND_ROOTLESS_RUNTIME_DIR" "$DIND_DATA_ROOT" "$_DIND_ROOTLESS_HOME" /etc/docker/certs.d \
       || ! touch "$_DIND_ROOTLESS_LOG" || ! chown "$OWNER": "$_DIND_ROOTLESS_LOG"; then
        pipe_log_fail "Unable to prepare the directories of the rootless docker daemon, aborting" "$DIND_SETUP_TASK"
        exit 1
    fi
    dind_rootless_clean_runtime_dir "$_DIND_ROOTLESS_RUNTIME_DIR"
    if ! dind_rootless_check_userns "$OWNER" /usr/local/bin "$_DIND_ROOTLESS_RUNTIME_DIR"; then
        pipe_log_fail "RootlessKit cannot create a user namespace for $OWNER (see the output above), aborting" "$DIND_SETUP_TASK"
        exit 1
    fi
elif [ $REQUIRES_GPU_DIND -eq 0 ]; then
    # The image may be committed from a rootless run, which turned off the cgroups of the NVIDIA runtime
    dind_rootless_restore_nvidia
fi


######################################################
# Install buildx
######################################################
CP_CAP_DIND_BUILDX_ENABLED="${CP_CAP_DIND_BUILDX_ENABLED:-false}"
CP_CAP_DIND_BUILDX_VERSION="${CP_CAP_DIND_BUILDX_VERSION:-0.25.0}"
CP_CAP_DIND_BUILDX_INSTALL_DIR="${CP_CAP_DIND_BUILDX_INSTALL_DIR:-/usr/lib/docker/cli-plugins}"
CP_CAP_DIND_BUILDX_DISTR_PREFIX="${CP_CAP_DIND_BUILDX_DISTR_PREFIX:-"${GLOBAL_DISTRIBUTION_URL}tools/docker/buildx"}"
CP_CAP_DIND_BUILDX_BUILDER_NAME="${CP_CAP_DIND_BUILDX_BUILDER_NAME:-cp-builder}"

function dind_setup_buildx_proxies {
    pipe_log_info "Setting up buildx proxies" "$DIND_SETUP_TASK"
    docker buildx rm "$CP_CAP_DIND_BUILDX_BUILDER_NAME"
    docker buildx create \
        --name "$CP_CAP_DIND_BUILDX_BUILDER_NAME" \
        --use \
        --driver docker-container \
        --driver-opt env.http_proxy="$http_proxy" \
        --driver-opt env.https_proxy="$https_proxy" \
        --driver-opt '"env.no_proxy='$no_proxy'"'
}

if util_version_compare "$CP_CAP_DIND_VERSION" "19.03.0" ">" && \
    [ "$CP_CAP_DIND_BUILDX_ENABLED" != "false" ]; then

    pipe_log_info "Installing buildx plugin:" "$DIND_SETUP_TASK"
    pipe_log_info "- version: $CP_CAP_DIND_BUILDX_VERSION" "$DIND_SETUP_TASK"
    pipe_log_info "- url: $CP_CAP_DIND_BUILDX_DISTR_PREFIX" "$DIND_SETUP_TASK"
    pipe_log_info "- install dir: $CP_CAP_DIND_BUILDX_INSTALL_DIR" "$DIND_SETUP_TASK"
    
    mkdir -p "${CP_CAP_DIND_BUILDX_INSTALL_DIR}" && \
    wget -q -O "$CP_CAP_DIND_BUILDX_INSTALL_DIR/docker-buildx" "${CP_CAP_DIND_BUILDX_DISTR_PREFIX}/buildx-v${CP_CAP_DIND_BUILDX_VERSION}.linux-amd64" && \
    chmod +x "$CP_CAP_DIND_BUILDX_INSTALL_DIR/docker-buildx"

    if [ $? -ne 0 ]; then
        pipe_log_warn "buildx installation failed" "$DIND_SETUP_TASK"
    else
        if [ "$http_proxy" ] || [ "$https_proxy" ] || [ "$no_proxy" ]; then
            if [ "$_DIND_ROOTLESS" == "true" ]; then
                # The rootless daemon is started below, the builder needs it
                _DIND_BUILDX_PROXIES_PENDING="true"
            else
                dind_setup_buildx_proxies
            fi
        fi
    fi
fi

######################################################
# Start dockerd
######################################################
if [ "$_DIND_ROOTLESS" == "true" ]; then
    _DIND_ROOTLESS_DOCKER_HOST="$(dind_rootless_docker_host "$OWNER")"
    # The link goes first: RootlessKit copies /run for the daemon as it starts, and the containers
    # that mount /var/run/docker.sock see that copy
    if ! dind_rootless_link_default_socket "${_DIND_ROOTLESS_DOCKER_HOST#unix://}"; then
        pipe_log_warn "/var/run/docker.sock exists and is kept, the processes without DOCKER_HOST won't reach the rootless daemon" "$DIND_SETUP_TASK"
    fi
    dind_rootless_start "$OWNER" /usr/local/bin "$_DIND_ROOTLESS_HOME" "$_DIND_ROOTLESS_RUNTIME_DIR" \
                        /etc/docker/daemon.json "$_DIND_ROOTLESS_LOG"
    export DOCKER_HOST="$_DIND_ROOTLESS_DOCKER_HOST"
    if ! dind_rootless_export_docker_host "$CP_ENV_FILE_TO_SOURCE" "$DOCKER_HOST"; then
        pipe_log_warn "Unable to add DOCKER_HOST to the run environment, set DOCKER_HOST=$DOCKER_HOST to use docker" "$DIND_SETUP_TASK"
    fi
else
    nohup dind_setup_entrypoint dockerd > /var/log/dockerd-entrypoint.log 2>&1 &
fi

pipe_log_info "Waiting for Docker daemon to be ready" "$DIND_SETUP_TASK"
_DIND_WAIT_TIMEOUT="${CP_CAP_DIND_WAIT_TIMEOUT:-60}"
_DIND_WAIT_ELAPSED=0
while ! docker info > /dev/null 2>&1; do
    if [ "$_DIND_WAIT_ELAPSED" -ge "$_DIND_WAIT_TIMEOUT" ]; then
        if [ "$_DIND_ROOTLESS" == "true" ]; then
            tail -n 20 "$_DIND_ROOTLESS_LOG"
        fi
        pipe_log_fail "Docker daemon did not become ready within ${_DIND_WAIT_TIMEOUT}s" "$DIND_SETUP_TASK"
        exit 1
    fi
    sleep 2
    _DIND_WAIT_ELAPSED=$((_DIND_WAIT_ELAPSED + 2))
done

if [ "$_DIND_BUILDX_PROXIES_PENDING" == "true" ]; then
    dind_setup_buildx_proxies
fi

if [ "$_DIND_ROOTLESS" == "true" ]; then
    pipe_log_info "Docker daemon runs in the rootless mode as $OWNER, DOCKER_HOST=$DOCKER_HOST" "$DIND_SETUP_TASK"
fi
pipe_log_success "Docker daemon started" "$DIND_SETUP_TASK"
