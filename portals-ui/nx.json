{
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "dev": {
      "cache": false,
      "dependsOn": [
        "^build"
      ]
    },
    "preview": {
      "cache": false,
      "dependsOn": ["build"],
      "outputs": [
        "{projectRoot}/dist"
      ]
    }
  }
}