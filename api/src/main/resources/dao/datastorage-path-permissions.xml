<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    <bean class="com.epam.pipeline.dao.datastorage.permissions.StoragePathPermissionsDao" id="dataStoragePathPermissionsDao"
          autowire="byName">
        <constructor-arg>
            <value>
                <!--insertStoragePathPermissionsQuery-->
                <![CDATA[
                    INSERT INTO pipeline.datastorage_path_permissions (
                        storage_id,
                        folder_path,
                        file_name,
                        sid_name,
                        principal,
                        mask
                    )
                    VALUES (
                        :STORAGE_ID,
                        :FOLDER_PATH,
                        :FILE_NAME,
                        :SID_NAME,
                        :PRINCIPAL,
                        :MASK
                    )
                ]]>
            </value>
        </constructor-arg>
        <constructor-arg>
            <value>
                <!--deleteStoragePathPermissionsQuery-->
                <![CDATA[
                    DELETE FROM
                        pipeline.datastorage_path_permissions p
                    WHERE
                        p.storage_id = ?
                    @WHERE@
                ]]>
            </value>
        </constructor-arg>
        <constructor-arg>
            <value>
                <!--loadStoragePathPermissionsQuery-->
                <![CDATA[
                    SELECT
                        p.storage_id,
                        p.folder_path,
                        p.file_name,
                        p.sid_name,
                        p.principal,
                        p.mask
                    FROM
                        pipeline.datastorage_path_permissions p
                    WHERE
                        p.storage_id = ?
                    @WHERE@
                    ORDER BY LENGTH(p.folder_path) DESC, p.file_name DESC NULLS LAST
                    @LIMIT@
                ]]>
            </value>
        </constructor-arg>
        <constructor-arg>
            <value>
                <!--deleteStoragePathPermissionsByStorageIdQuery-->
                <![CDATA[
                    DELETE FROM
                        pipeline.datastorage_path_permissions p
                    WHERE
                        p.storage_id = ?
                ]]>
            </value>
        </constructor-arg>
        <constructor-arg>
            <value>
                <!--findStoragePathPermissionsByPrefixQuery-->
                <![CDATA[
                    SELECT
                        p.storage_id,
                        p.folder_path,
                        p.file_name,
                        p.sid_name,
                        p.principal,
                        p.mask
                    FROM
                        pipeline.datastorage_path_permissions p
                    WHERE
                        p.storage_id = :STORAGE_ID AND p.folder_path LIKE :FOLDER_PATH
                    @WHERE@
                    ORDER BY LENGTH(p.folder_path) ASC
                ]]>
            </value>
        </constructor-arg>
        <constructor-arg>
            <value>
                <!--countStoragePathPermissionsQuery-->
                <![CDATA[
                    SELECT
                        count(*)
                    FROM
                        pipeline.datastorage_path_permissions p
                    WHERE
                        p.storage_id = ?
                    @WHERE@
                ]]>
            </value>
        </constructor-arg>
        <constructor-arg>
            <value>
                <!--findSidsWithStoragePathPermissionsQuery-->
                <![CDATA[
                    SELECT DISTINCT
                        p.sid_name,
                        p.principal
                    FROM
                        pipeline.datastorage_path_permissions p
                    WHERE
                        p.storage_id = ?
                ]]>
            </value>
        </constructor-arg>
    </bean>
</beans>
