{
  "name": "remote-cp",
  "displayName": "Remote - Cloud Pipeline",
  "description": "VSCode Remote Development connector to EPAM Cloud Pipeline platform runs",
  "version": "0.0.1",
  "publisher": "epam",
  "icon": "resources/remote-cp.png",
  "type": "module",
  "engines": {
    "vscode": "^1.96.0"
  },
  "extensionKind": [
    "ui"
  ],
  "enabledApiProposals": [
    "resolvers",
    "contribViewsRemote"
  ],
  "extensionPack": [
    "ms-vscode-remote.remote-ssh-edit",
    "ms-vscode.remote-explorer"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "remote development",
    "remote",
    "ssh",
    "Cloud Pipeline",
    "EPAM",
    "pipe",
    "cp"
  ],
  "api": "none",
  "activationEvents": [
    "onResolveRemoteAuthority:cp",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "remote-cp.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "remote-cp.connectToRun",
        "title": "%command.connectToRun%",
        "category": "CP"
      }
    ],
    "statusBar/remoteIndicator": [
      {
        "command": "remote-cp.connectToRun",
        "when": "((isWindows && !isWeb) || cpFeatureInstalled) && !wsl.openInNewWindow",
        "group": "remote_10_wsl_0_local@1"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "yarn run check-types && yarn run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "yarn run check-types && yarn run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.103.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.25.8",
    "eslint": "^9.32.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@enonic/fnv-plus": "^1.3.0",
    "@microsoft/dev-tunnels-contracts": "^1.0.7463",
    "@vscode/chat-extension-utils": "^0.0.0-alpha.4",
    "@vscode/extension-telemetry": "^0.9.0",
    "@vscode/prompt-tsx": "^0.3.0-alpha.13",
    "glob": "^10.3.10",
    "https-proxy-agent": "^7.0.2",
    "lockfile": "^1.0.4",
    "minimist": "^1.2.8",
    "posix-getopt": "^1.2.1",
    "shell-quote": "^1.8.1",
    "socks": "^2.7.3",
    "ssh-config": "^5.0.2",
    "table": "^6.8.2"
  },
  "packageManager": "yarn@4.9.4+sha512.7b1cb0b62abba6a537b3a2ce00811a843bea02bcf53138581a6ae5b1bf563f734872bd47de49ce32a9ca9dcaff995aa789577ffb16811da7c603dcf69e73750b"
}