<!--
  ~ Placeholders are substituted by the launcher scripts. A variant shall be defined
  ~ for each of the configured layouts, i.e. "_XKB_VARIANTS_" is a list of empty variants,
  ~ e.g. ",," for the "us,fr,de" layouts.
  -->

<channel name="keyboard-layout" version="1.0">
  <property name="Default" type="empty">
    <property name="XkbDisable" type="bool" value="false"/>
    <property name="XkbLayout" type="string" value="_XKB_LAYOUTS_"/>
    <property name="XkbVariant" type="string" value="_XKB_VARIANTS_"/>
    <property name="XkbOptions" type="empty">
      <property name="Group" type="string" value="_XKB_TOGGLE_"/>
    </property>
  </property>
</channel>
