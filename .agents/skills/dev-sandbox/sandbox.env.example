# Dev sandbox configuration. Copy to .env.sandbox.local in the repository root (the main
# checkout's, when you work in worktrees), which is gitignored, and fill it in. scripts/sandbox.sh
# copies it there itself when the file is missing.
#
# Docker reads this file with --env-file: one KEY=value per line, no spaces around `=`, no
# `export`, and a `#` comment only at the start of a line. Quotes around a value are optional.
#
# `sandbox.sh check` checks what this file names against the account, and changes nothing. It
# reads with sts:GetCallerIdentity, ec2:DescribeVpcs, ec2:DescribeSubnets, ec2:DescribeRouteTables,
# ec2:DescribeNatGateways, ec2:DescribeSecurityGroups, ec2:DescribeInstanceTypeOfferings,
# iam:GetInstanceProfile and iam:ListAttachedRolePolicies. README.md lists what the other commands
# need.

# --- Credentials: a profile from ~/.aws, or keys. Required.
# Prefer a profile with short-lived credentials, such as SSO or a role it assumes, or the keys of
# an IAM user of their own with only the permissions README.md lists: the API that
# `sandbox.sh services` runs hands its credentials to every run's pod, and its log holds them.
# `sandbox.sh check` warns of long-term keys: an access key ID that starts with AKIA, or no
# session token.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- The region of everything below. Required.
AWS_REGION=

# --- A network that already exists. Required.
CP_SANDBOX_VPC_ID=
# Available, in the VPC, with free addresses. The instances get no public IP and download from the
# internet, so the subnet's route table needs an active 0.0.0.0/0 route to a NAT gateway. Another
# target, such as a transit gateway, is taken on trust; an internet gateway will not do.
CP_SANDBOX_SUBNET_ID=
# Comma-separated, all in the VPC. One of them must allow all traffic from itself, and one
# outbound TCP 443 to 0.0.0.0/0.
CP_SANDBOX_SECURITY_GROUP_IDS=

# --- Instance profiles: a name or an ARN.
# Required. For the master and the host image builder. Its role has AmazonSSMManagedInstanceCore
# attached.
CP_SANDBOX_INSTANCE_PROFILE=
# Optional. For autoscaled workers. Defaults to CP_SANDBOX_INSTANCE_PROFILE.
CP_SANDBOX_WORKER_INSTANCE_PROFILE=

# --- Who owns the sandboxes: a login or an e-mail, used in the tags. Required.
CP_SANDBOX_OWNER=

# --- Optional. x86_64 instance types, offered in the subnet's availability zone. Defaults:
# t3.medium for both. The API that `sandbox.sh services` runs launches the worker type only.
CP_SANDBOX_MASTER_INSTANCE_TYPE=
CP_SANDBOX_WORKER_INSTANCE_TYPE=

# --- Optional. Hours until a new sandbox expires. Default: 48.
CP_SANDBOX_TTL_HOURS=

# --- Optional. The published build of the platform whose pipe-common, pipe and the other files a
# run downloads, which `sandbox.sh services` serves from the master: the URL of a
# cloud-pipeline.<version>.tgz. Default: the newest one under
# https://cloud-pipeline-oss-builds.s3.amazonaws.com/builds/develop/.
CP_SANDBOX_DISTRIBUTION_URL=
