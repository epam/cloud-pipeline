DCV_INSTALL_TASK="NiceDCVInitialization"

_user_name="${1:-$OWNER}"

if [ -z "$_user_name" ]; then
    pipe_log_fail "User is not defined for the DCV session creation" "$DCV_INSTALL_TASK"
    exit 1
fi

# Wayland (e.g. Rocky Linux 10): the DCV build has no Xdcv, and its GNOME Shell extension connects the GNOME session
# to DCV. Anything else is an X11 setup
if ! command -v Xdcv &> /dev/null && rpm -q nice-dcv-gnome-shell-extension &> /dev/null; then
    # A session runs the GNOME desktop, started by GDM, and DCV does not support an initialization script there
    if [ "$CP_DCV_INIT_SCRIPT" ]; then
        pipe_log_warn "[WARNING] DCV does not support an initialization script on Wayland, '$CP_DCV_INIT_SCRIPT' is not used" "$DCV_INSTALL_TASK"
    fi

    # A session starts at the GDM login screen. DCV logs in there only with a password (authentication="system"),
    # while a run uses authentication="none". So the GDM login is passwordless for the user of the session only
    _gdm_pam_file="/etc/pam.d/gdm-password"
    _gdm_login_rule="auth        sufficient    pam_succeed_if.so quiet user = $_user_name"
    if [ ! -f "$_gdm_pam_file" ]; then
        pipe_log_warn "[WARNING] $_gdm_pam_file is not found, '$_user_name' will need a password at the GDM login screen" "$DCV_INSTALL_TASK"
    elif ! grep -qxF "$_gdm_login_rule" "$_gdm_pam_file"; then
        { echo "$_gdm_login_rule"; cat "$_gdm_pam_file"; } > "$_gdm_pam_file.cp-dcv" && \
            cat "$_gdm_pam_file.cp-dcv" > "$_gdm_pam_file"
        rm -f "$_gdm_pam_file.cp-dcv"
    fi

    # The login screen lists the regular users, which AccountsService knows, and which have a password (the run sets
    # one for its owner). The user of the session is registered there, to be selected in that list. accounts-daemon
    # does not watch its folder of users, so the user is registered by the daemon itself (CacheUser), and the record
    # is written into the folder only if the daemon is not available
    if ! busctl call org.freedesktop.Accounts /org/freedesktop/Accounts org.freedesktop.Accounts \
            CacheUser s "$_user_name" &> /dev/null; then
        _accounts_users_dir="/var/lib/AccountsService/users"
        if [ ! -f "$_accounts_users_dir/$_user_name" ]; then
            mkdir -p "$_accounts_users_dir"
            printf '[User]\nSystemAccount=false\n' > "$_accounts_users_dir/$_user_name"
        fi
    fi

    dcv create-session --type virtual --owner "$_user_name" --user "$_user_name" "${_user_name//./}-session"
else
    # X11: a session runs in an X server of DCV (Xdcv), and the initialization script starts its desktop
    CP_DCV_INIT_SCRIPT="${CP_DCV_INIT_SCRIPT:-/opt/dcv/extras/xfce4launch}"
    if [ "$CP_DCV_INIT_SCRIPT" ]; then
        CP_DCV_INIT_SCRIPT="--init $CP_DCV_INIT_SCRIPT"
        pipe_log_info "Using '$CP_DCV_INIT_SCRIPT' initialization script for a DCV session" "$DCV_INSTALL_TASK"
    fi
    dcv create-session --owner $_user_name --user $_user_name $CP_DCV_INIT_SCRIPT "${_user_name//./}-session"
fi

if [ $? -ne 0 ]; then
    pipe_log_fail "Cannot create DCV session for '$_user_name'" "$DCV_INSTALL_TASK"
else
    pipe_log_info "DCV session was created for '$_user_name'" "$DCV_INSTALL_TASK"
fi