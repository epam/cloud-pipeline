<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    <bean class="com.epam.pipeline.dao.security.JwtTokenRevocationDao" id="jwtTokenRevocationDao" autowire="byName">
        <property name="upsertRevocationQuery">
            <value>
                <![CDATA[
                    INSERT INTO pipeline.jwt_token_revocation (jti, revoked_at)
                    VALUES (:JTI, :REVOKED_AT)
                    ON CONFLICT (jti) DO UPDATE SET revoked_at = EXCLUDED.revoked_at
                ]]>
            </value>
        </property>
        <property name="existsByJtiQuery">
            <value>
                <![CDATA[
                    SELECT EXISTS (SELECT 1 FROM pipeline.jwt_token_revocation WHERE jti = ?)
                ]]>
            </value>
        </property>
        <property name="insertRevocationsForUserQuery">
            <value>
                <![CDATA[
                    INSERT INTO pipeline.jwt_token_revocation (jti, revoked_at)
                    SELECT jti, :REVOKED_AT
                    FROM pipeline.jwt_named_token
                    WHERE user_id = :USER_ID
                    ON CONFLICT (jti) DO UPDATE SET revoked_at = EXCLUDED.revoked_at
                ]]>
            </value>
        </property>
    </bean>
</beans>
