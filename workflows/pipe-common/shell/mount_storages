MOUNT_ROOT=$1
TMP_DIR=$2
MOUNT_TASK_NAME=$3
MOUNT_LOG_FILE=$4

# Check global variables
if [ -z "$API" ]
  then
    echo "[ERROR] API Url is not set"
	  exit 1
fi

# Check global variables
if [ -z "$API_TOKEN" ]
  then
    echo "[ERROR] API Token is not set"
	  exit 1
fi

# Check arguments
if [ -z "$MOUNT_ROOT" ]
  then
    echo "[ERROR] Mount root point text shall be supplied"
	exit 1
fi

if [ -z "$TMP_DIR" ]
  then
    echo "[ERROR] Temporary directory shall be supplied"
	exit 1
fi

if [ -z "$MOUNT_TASK_NAME" ]
  then
    echo "[ERROR] Task name shall be supplied"
	exit 1
fi

if [ -z "$MOUNT_LOG_FILE" ]
  then
    MOUNT_LOG_FILE="$LOG_DIR/${MOUNT_TASK_NAME}.log"
fi

MOUNT_CHECK_INTERVAL="${MOUNT_CHECK_INTERVAL:-1}"
INIT_MOUNT_STATUS_FILE="/tmp/init_mount_status"

function check_mount_status() {
    [[ ! -f "$MOUNT_STATUS_FILE" ]] && return 2
    case "$(cat "$MOUNT_STATUS_FILE")" in
        SUCCESS) return 0 ;;
        FAILURE) return 1 ;;
        *) return 2 ;;
    esac
}

is_process_running() {
    local pid="$1"
    kill -0 "$pid" &> /dev/null
}

nohup $CP_PYTHON2_PATH "${COMMON_REPO_DIR}/scripts/mount_storage.py" \
                       --mount-root "${MOUNT_ROOT}" \
                       --tmp-dir "${TMP_DIR}" \
                       --task "${MOUNT_TASK_NAME}" \
                       --status-file "${INIT_MOUNT_STATUS_FILE}" \
                       1>/dev/null 2> $MOUNT_LOG_FILE &
MOUNT_STORAGE_PID="$!"

while is_process_running "$MOUNT_STORAGE_PID"; do
    check_mount_status
    status=$?

    case $status in
        0|1) exit $status ;;
        2) sleep "$MOUNT_CHECK_INTERVAL" ;;
    esac
done

check_mount_status
exit $?
