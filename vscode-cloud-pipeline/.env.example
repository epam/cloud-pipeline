# Optional extension defaults (copy to `.env` beside package.json in this folder).
# Parsed at runtime from the installed extension directory; does not modify the editor process environment.

# When set, Sign in skips the API URL prompt and uses this base URL (trailing slash optional).
# CLOUD_PIPELINE_DEFAULT_API_URL=https://example.com/pipeline/restapi

# Shown in notifications, progress, status bar, and the runs tree view title (unless overridden below).
# CLOUD_PIPELINE_BRAND_NAME=Cloud Pipeline

# Optional full override for the tree view tab label (default is "${CLOUD_PIPELINE_BRAND_NAME} Runs").
# CLOUD_PIPELINE_TREE_VIEW_TITLE=My Runs

# When set, the extension polls for updates every 10 minutes and prompts the user to install if
# the server-side component hash differs from the installed one. Leave unset to disable auto-update.
# CLOUD_PIPELINE_VSIX_UPDATE_URL=https://example.com/pipeline/cloud-pipeline-remote.vsix
