<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    <bean class="com.epam.pipeline.dao.pipeline.PipelineRunMetricsDao" id="pipelineRunMetricsDao" autowire="byName">
        <property name="putRunMetricsByIdQuery">
            <value>
                <![CDATA[
                    INSERT INTO pipeline.pipeline_run_metrics (
                        run_id,
                        metric_type,
                        max_value,
                        avg_value,
                        capacity)
                    VALUES (
                        :RUN_ID,
                        :METRIC_TYPE,
                        :MAX_VALUE,
                        :AVG_VALUE)
                    ON CONFLICT (run_id, metric_type) DO NOTHING
                ]]>
            </value>
        </property>
        <property name="loadRunMetricsByIdQuery">
            <value>
                <![CDATA[
                    SELECT * FROM pipeline.pipeline_run_metrics
                    WHERE run_id = :RUN_ID
                ]]>
            </value>
        </property>
    </bean>
</beans>
