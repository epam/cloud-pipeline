{
  "name": "cp-client-tunnel",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build:this": "npm run check && tsc -p .",
    "build": "npm run --prefix .. prebuild:cp-client-tunnel && npm run build:this",
    "check": "npm run check-types && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "cp-client-common": "file:../cp-client-common",
    "ps-list": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3"
  }
}