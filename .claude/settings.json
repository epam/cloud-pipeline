{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew checkstyleMain:*)",
      "Bash(./gradlew checkstyleTest:*)",
      "Bash(./gradlew pmdMain:*)",
      "Bash(./gradlew pmdTest:*)",
      "Bash(./gradlew :api:test:*)",
      "Bash(./gradlew :core:test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run stylelint:*)",
      "Bash(npm test:*)",
      "Bash(.agents/skills/commit-changes/scripts/verify-docs.sh:*)",
      "Bash(bash .agents/skills/commit-changes/scripts/verify-docs.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)",
      "Bash(git worktree add:*)"
    ],
    "deny": [
      "Bash(pipectl:*)",
      "Bash(docker push:*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws s3 mv:*)",
      "Bash(aws s3 sync:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl apply:*)",
      "Bash(deploy/pipectl/build-pipectl.sh:*)",
      "Bash(./deploy/pipectl/build-pipectl.sh:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh pr ready:*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.kube/config)",
      "Read(~/.gnupg/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git worktree remove:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh issue edit:*)",
      "Bash(npm install:*)",
      "Bash(./gradlew buildAll:*)",
      "Bash(./gradlew buildAllFast:*)",
      "Bash(./gradlew distZip:*)",
      "Bash(./gradlew distTar:*)",
      "Bash(./gradlew buildDoc:*)",
      "Bash(./gradlew bootRepackage:*)",
      "Bash(./gradlew buildUI:*)",
      "Bash(./gradlew buildPipe:*)",
      "Bash(e2e/gui/gradlew:*)",
      "Bash(./e2e/gui/gradlew:*)"
    ]
  }
}
