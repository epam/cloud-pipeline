{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "preserveSymlinks": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "cp-client-tunnel": [
        "./node_modules/cp-client-tunnel/dist"
      ],
      "cp-client-common": [
        "./node_modules/cp-client-common/dist"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}