ARG BASE_IMG=rockylinux/rockylinux:9.8
FROM $BASE_IMG

# Install common dependencies
RUN dnf install -y wget \
                   tmux \
                   bzip2 \
                   gcc \
                   g++ \
                   zlib-devel \
                   bzip2-devel \
                   xz-devel \
                   make \
                   ncurses-devel \
                   unzip \
                   git \
                   fuse \
                   tzdata \
                   fuse \
                   acl \
                   openssh-server \
                   yum-utils \
                   dnf-utils \
                   findutils \
                   rsync \
                   sudo \
                   procps-ng \
                   vim-minimal \
                   nano \
                   gettext \
                   libxcrypt-compat \
                   xz && \
    dnf clean all
RUN dnf install -y --allowerasing coreutils curl
# Install python
RUN dnf install -y openssl-devel \
                    libffi-devel \
                    sqlite-devel \
                    tk-devel \
                    readline-devel && \
    dnf clean all
RUN cd /tmp/ && \
    wget --no-check-certificate https://www.python.org/ftp/python/2.7.18/Python-2.7.18.tgz && \
    tar xzf Python-2.7.18.tgz && \
    cd Python-2.7.18 && \
    ./configure --prefix=/opt/local/python/2.7.18/ && \
    make -j$(nproc) && \
    make altinstall && \
    rm -rf /tmp/Python* && \
    ln -s /opt/local/python/2.7.18/bin/python2.7 /usr/local/bin/python2 && \
    ln -s /opt/local/python/2.7.18/bin/python2.7 /usr/local/bin/python2.7
# Install pip
RUN curl -s https://cloud-pipeline-oss-builds.s3.amazonaws.com/tools/pip/2.7/get-pip.py | python2 && \
    python2 -m pip install \
    --index-url http://cloud-pipeline-oss-builds.s3-website-us-east-1.amazonaws.com/tools/python/pypi/simple \
    --trusted-host cloud-pipeline-oss-builds.s3-website-us-east-1.amazonaws.com \
    -I -q setuptools==44.1.1
# Install NFS/SMB/Lustre clients
RUN dnf install nfs-utils cifs-utils -y
RUN cd /tmp && \
    wget -q https://cloud-pipeline-oss-builds.s3.amazonaws.com/tools/lustre/client/rpm/lustre-client-2.10.8-2.el8.x86_64.tar.gz -O lustre-client.tar.gz && \
    mkdir -p lustre-client && \
    tar -xzvf lustre-client.tar.gz -C lustre-client/ && \
    rpm -i --justdb --quiet --nodeps --force lustre-client/dependencies/*.rpm && \
    yum install -y lustre-client/*.rpm && \
    (package-cleanup --cleandupes -y || true) && \
    rm -rf lustre-client*

# Environment modules: Lmod is built here, so a run only configures it (modules_setup with CP_CAP_MODULE_PREINSTALLED)
# - lua-devel is in the CRB repository, which the Rocky Linux 9 images have disabled
# - Rocky Linux 9 has only Lua 5.4, which Lmod accepts from 8.4 on (Lmod-8.3.tar.gz in the distribution refuses it)
# - Lmod builds its own lfs and term, and brings its own json.lua, so lua-filesystem and lua-json (EPEL only on EL9)
#   are not needed; it does not use lua-lpeg
# - Lmod 8.7.67 needs bc
ARG LMOD_VERSION=8.7.67
ARG LMOD_SHA256=50c8d265e47eb6661ebe3af13df819b35db84cda3474ea0a7427c33b5767aaab
RUN dnf install -y --enablerepo=crb lua lua-devel lua-posix tcl-devel bc less && \
    dnf clean all && \
    mkdir -p /tmp/modules-tmp && \
    cd /tmp/modules-tmp && \
    wget -q "https://github.com/TACC/Lmod/archive/refs/tags/${LMOD_VERSION}.tar.gz" -O modules.tar.gz && \
    echo "${LMOD_SHA256}  modules.tar.gz" | sha256sum -c - && \
    tar -zxf modules.tar.gz && \
    cd Lmod-${LMOD_VERSION} && \
    ./configure --prefix=/usr/local && \
    make install && \
    cd / && \
    rm -rf /tmp/modules-tmp
# modules_setup sets MODULES_INSTALL_DIR only when it builds the modules itself, and configures the type it is given,
# "tcl" by default: both must match what is installed here. Only Lmod is installed, so a run that sets
# CP_CAP_MODULES_TYPE=tcl (a run parameter or the launch env overrides this ENV) gets no "module" command
ENV CP_CAP_MODULE_PREINSTALLED=true
ENV MODULES_INSTALL_DIR=/usr/local
ENV CP_CAP_MODULES_TYPE=lmod